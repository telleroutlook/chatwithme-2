{
  "name": "chatwithme-mcp",
  "description": "ChatWithMe MCP - AI Chat with MCP tool integration",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev --port 8787",
    "dev:vite": "vite dev",
    "start": "vite build && wrangler dev --port 8787",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run typecheck && vite build && wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/run-d1-migrations.mjs local token_db",
    "db:migrate:prod": "node scripts/run-d1-migrations.mjs prod token_db",
    "db:studio": "drizzle-kit studio",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node test/e2e/smoke.production.mjs",
    "test:e2e:session-delete": "node test/e2e/session-delete.production.mjs",
    "test:e2e:scroll-lock": "node test/e2e/scroll-lock.production.mjs",
    "test:cli": "bash test/e2e/cli/run-all-tests.sh",
    "test:cli:api": "bash test/e2e/cli/run-all-tests.sh http://localhost:8787 api",
    "test:cli:ui": "bash test/e2e/cli/run-all-tests.sh http://localhost:8787 ui",
    "test:cli:mobile": "bash test/e2e/cli/run-all-tests.sh http://localhost:8787 mobile",
    "deploy:raw": "vite build && wrangler deploy",
    "kb:refresh": "node scripts/fetch-chart-knowledge.mjs",
    "kb:refresh:strict": "node scripts/fetch-chart-knowledge.mjs --strict",
    "kb:validate": "node scripts/validate-chart-knowledge.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.30",
    "@ai-sdk/react": "^3.0.0",
    "@ant-design/charts": "^2.6.7",
    "@cloudflare/ai-chat": "^0.1.9",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@excalidraw/excalidraw": "^0.18.0",
    "@hono/zod-validator": "^0.4.3",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "agents": "^0.7.9",
    "ai": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.1",
    "echarts": "^5.6.0",
    "hono": "^4.6.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.0",
    "katex": "^0.16.33",
    "mammoth": "^1.12.0",
    "markmap-common": "^0.18.9",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mathjs": "^15.1.1",
    "mermaid": "^11.12.3",
    "nanoid": "^5.1.6",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.0",
    "tailwind-merge": "^3.5.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.1",
    "@eslint/js": "^9.39.3",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.0.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.75.0"
  }
}
