{
  "outputContract": [
    "G2 blocks must be strict RFC 8259 JSON",
    "Do not output comments, trailing commas, undefined, NaN, Infinity, or functions",
    "All keys must use double quotes; all string values must use double quotes",
    "Never output callback expressions such as (d) => ... or function (...)",
    "For constant colors, use string literals like \"#4E79A7\"",
    "For categorical color mapping, use \"encode\": { \"color\": \"<field>\" }",
    "scale.color.range must contain only valid CSS color strings (hex/rgb/hsl), never category labels",
    "encode.x/encode.y/encode.color referenced fields must exist in data",
    "If you output a G2 code block, self-check that it can pass JSON.parse",
    "Always include at least 4-6 realistic data points for visual clarity",
    "Use descriptive field names in data (e.g., 'month', 'revenue') rather than generic ('x', 'y')"
  ],
  "chartTypes": [
    {
      "type": "interval",
      "requiredFields": [
        "data",
        "encode"
      ],
      "example": "{\"type\":\"interval\",\"data\":[{\"quarter\":\"Q1\",\"revenue\":120,\"department\":\"Sales\"},{\"quarter\":\"Q2\",\"revenue\":180,\"department\":\"Sales\"},{\"quarter\":\"Q3\",\"revenue\":150,\"department\":\"Sales\"},{\"quarter\":\"Q4\",\"revenue\":200,\"department\":\"Sales\"},{\"quarter\":\"Q1\",\"revenue\":80,\"department\":\"Marketing\"},{\"quarter\":\"Q2\",\"revenue\":120,\"department\":\"Marketing\"},{\"quarter\":\"Q3\",\"revenue\":100,\"department\":\"Marketing\"},{\"quarter\":\"Q4\",\"revenue\":150,\"department\":\"Marketing\"}],\"encode\":{\"x\":\"quarter\",\"y\":\"revenue\",\"color\":\"department\"},\"transform\":[{\"type\":\"dodgeX\"}],\"style\":{\"radiusTopLeft\":4,\"radiusTopRight\":4},\"axis\":{\"y\":{\"title\":\"Revenue ($K)\"}},\"tooltip\":true}",
      "commonErrors": [
        "Missing encode object",
        "Using xField/yField instead of encode.x/encode.y",
        "Not providing data array"
      ],
      "tips": "Use encode.color for grouped bars. Add transform:[{type:'dodgeX'}] for side-by-side grouping or [{type:'stackY'}] for stacking."
    },
    {
      "type": "line",
      "requiredFields": [
        "data",
        "encode"
      ],
      "example": "{\"type\":\"line\",\"data\":[{\"date\":\"2024-01\",\"value\":120,\"metric\":\"Downloads\"},{\"date\":\"2024-02\",\"value\":180,\"metric\":\"Downloads\"},{\"date\":\"2024-03\",\"value\":150,\"metric\":\"Downloads\"},{\"date\":\"2024-04\",\"value\":220,\"metric\":\"Downloads\"},{\"date\":\"2024-01\",\"value\":80,\"metric\":\"Signups\"},{\"date\":\"2024-02\",\"value\":110,\"metric\":\"Signups\"},{\"date\":\"2024-03\",\"value\":130,\"metric\":\"Signups\"},{\"date\":\"2024-04\",\"value\":170,\"metric\":\"Signups\"}],\"encode\":{\"x\":\"date\",\"y\":\"value\",\"color\":\"metric\"},\"style\":{\"lineWidth\":2.5},\"axis\":{\"y\":{\"title\":\"Count\"}},\"tooltip\":true}",
      "commonErrors": [
        "Using style.strokeWidth as callback",
        "Missing encode.x or encode.y"
      ],
      "tips": "Use encode.color for multi-line. style.lineWidth for thickness. Add axis.y.title for y-axis label."
    },
    {
      "type": "area",
      "requiredFields": [
        "data",
        "encode"
      ],
      "example": "{\"type\":\"area\",\"data\":[{\"month\":\"Jan\",\"value\":100,\"type\":\"Revenue\"},{\"month\":\"Feb\",\"value\":140,\"type\":\"Revenue\"},{\"month\":\"Mar\",\"value\":170,\"type\":\"Revenue\"},{\"month\":\"Apr\",\"value\":200,\"type\":\"Revenue\"},{\"month\":\"Jan\",\"value\":60,\"type\":\"Cost\"},{\"month\":\"Feb\",\"value\":80,\"type\":\"Cost\"},{\"month\":\"Mar\",\"value\":95,\"type\":\"Cost\"},{\"month\":\"Apr\",\"value\":110,\"type\":\"Cost\"}],\"encode\":{\"x\":\"month\",\"y\":\"value\",\"color\":\"type\"},\"transform\":[{\"type\":\"stackY\"}],\"style\":{\"fillOpacity\":0.5},\"tooltip\":true}",
      "commonErrors": [
        "Same as line chart errors",
        "Not handling null values properly"
      ],
      "tips": "Use transform:[{type:'stackY'}] for stacked areas. style.fillOpacity (0.3-0.6) for transparency."
    },
    {
      "type": "point",
      "requiredFields": [
        "data",
        "encode"
      ],
      "example": "{\"type\":\"point\",\"data\":[{\"height\":170,\"weight\":65,\"gender\":\"Male\"},{\"height\":165,\"weight\":55,\"gender\":\"Female\"},{\"height\":180,\"weight\":80,\"gender\":\"Male\"},{\"height\":160,\"weight\":50,\"gender\":\"Female\"},{\"height\":175,\"weight\":72,\"gender\":\"Male\"},{\"height\":168,\"weight\":58,\"gender\":\"Female\"},{\"height\":185,\"weight\":85,\"gender\":\"Male\"},{\"height\":155,\"weight\":48,\"gender\":\"Female\"}],\"encode\":{\"x\":\"height\",\"y\":\"weight\",\"color\":\"gender\",\"shape\":\"point\"},\"style\":{\"fillOpacity\":0.65,\"r\":5},\"axis\":{\"x\":{\"title\":\"Height (cm)\"},\"y\":{\"title\":\"Weight (kg)\"}},\"tooltip\":true}",
      "commonErrors": [
        "Missing encode.color for category distinction",
        "Using wrong mark type for scatter plots"
      ],
      "tips": "Use encode.color for categories. style.r for point radius. Add axis titles for labeled axes."
    },
    {
      "type": "cell",
      "requiredFields": [
        "data",
        "encode"
      ],
      "example": "{\"type\":\"cell\",\"data\":[{\"day\":\"Mon\",\"hour\":\"9am\",\"value\":10},{\"day\":\"Mon\",\"hour\":\"12pm\",\"value\":25},{\"day\":\"Mon\",\"hour\":\"3pm\",\"value\":18},{\"day\":\"Tue\",\"hour\":\"9am\",\"value\":15},{\"day\":\"Tue\",\"hour\":\"12pm\",\"value\":30},{\"day\":\"Tue\",\"hour\":\"3pm\",\"value\":22},{\"day\":\"Wed\",\"hour\":\"9am\",\"value\":8},{\"day\":\"Wed\",\"hour\":\"12pm\",\"value\":28},{\"day\":\"Wed\",\"hour\":\"3pm\",\"value\":16}],\"encode\":{\"x\":\"day\",\"y\":\"hour\",\"color\":\"value\"},\"style\":{\"inset\":1},\"scale\":{\"color\":{\"palette\":\"ylGnBu\"}},\"tooltip\":true}",
      "commonErrors": [
        "Missing encode.color for heat values",
        "Not using proper grid data format"
      ],
      "tips": "Provide complete grid data. Use scale.color.palette for heatmap color schemes. style.inset for cell gaps."
    }
  ]
}
