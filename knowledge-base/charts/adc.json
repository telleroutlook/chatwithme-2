{
  "outputContract": [
    "ADC blocks must be strict RFC 8259 JSON",
    "Do not output comments, trailing commas, undefined, NaN, Infinity, or functions",
    "All keys must use double quotes; all string values must use double quotes",
    "Never output callback expressions such as (d) => ... or function (...)",
    "Do not set label.position; renderer applies safe defaults by chart type",
    "Supported chart types: line, column, bar, area, pie, scatter, radar, gauge, heatmap, funnel, histogram, dualAxes",
    "Always include at least 4-6 realistic data points for visual clarity",
    "Use descriptive field names (e.g., 'month', 'revenue') rather than generic ('x', 'y')",
    "For multi-series charts, include a seriesField or colorField to distinguish categories"
  ],
  "typeWhitelist": [
    "line",
    "column",
    "bar",
    "area",
    "pie",
    "scatter",
    "radar",
    "gauge",
    "heatmap",
    "funnel",
    "histogram",
    "dualAxes"
  ],
  "chartTypes": [
    {
      "type": "line",
      "requiredFields": [
        "data",
        "xField",
        "yField"
      ],
      "example": "{\"type\":\"line\",\"data\":[{\"month\":\"Jan\",\"value\":35,\"category\":\"Series A\"},{\"month\":\"Feb\",\"value\":46,\"category\":\"Series A\"},{\"month\":\"Mar\",\"value\":51,\"category\":\"Series A\"},{\"month\":\"Apr\",\"value\":60,\"category\":\"Series A\"},{\"month\":\"Jan\",\"value\":28,\"category\":\"Series B\"},{\"month\":\"Feb\",\"value\":38,\"category\":\"Series B\"},{\"month\":\"Mar\",\"value\":43,\"category\":\"Series B\"},{\"month\":\"Apr\",\"value\":55,\"category\":\"Series B\"}],\"xField\":\"month\",\"yField\":\"value\",\"colorField\":\"category\",\"style\":{\"lineWidth\":2.5},\"point\":{\"shapeField\":\"circle\",\"sizeField\":3},\"interaction\":{\"tooltip\":true}}",
      "commonErrors": [
        "Using callback functions in field mappings",
        "Missing required xField or yField",
        "Data not in array format"
      ],
      "tips": "Use colorField for multi-series. Add point config for data point markers. Use style.lineWidth for thickness."
    },
    {
      "type": "column",
      "requiredFields": [
        "data",
        "xField",
        "yField"
      ],
      "example": "{\"type\":\"column\",\"data\":[{\"quarter\":\"Q1\",\"revenue\":120,\"department\":\"Sales\"},{\"quarter\":\"Q2\",\"revenue\":180,\"department\":\"Sales\"},{\"quarter\":\"Q3\",\"revenue\":150,\"department\":\"Sales\"},{\"quarter\":\"Q4\",\"revenue\":200,\"department\":\"Sales\"},{\"quarter\":\"Q1\",\"revenue\":90,\"department\":\"Marketing\"},{\"quarter\":\"Q2\",\"revenue\":130,\"department\":\"Marketing\"},{\"quarter\":\"Q3\",\"revenue\":110,\"department\":\"Marketing\"},{\"quarter\":\"Q4\",\"revenue\":160,\"department\":\"Marketing\"}],\"xField\":\"quarter\",\"yField\":\"revenue\",\"colorField\":\"department\",\"group\":true,\"style\":{\"radiusTopLeft\":4,\"radiusTopRight\":4},\"interaction\":{\"tooltip\":true}}",
      "commonErrors": [
        "Confusing column (vertical) with bar (horizontal)",
        "Missing required fields"
      ],
      "tips": "Use group:true or stack:true for multi-series. Add style.radiusTopLeft/radiusTopRight for rounded tops."
    },
    {
      "type": "bar",
      "requiredFields": [
        "data",
        "xField",
        "yField"
      ],
      "example": "{\"type\":\"bar\",\"data\":[{\"country\":\"China\",\"population\":1412},{\"country\":\"India\",\"population\":1408},{\"country\":\"USA\",\"population\":333},{\"country\":\"Indonesia\",\"population\":277},{\"country\":\"Brazil\",\"population\":216}],\"xField\":\"population\",\"yField\":\"country\",\"colorField\":\"country\",\"label\":{\"text\":\"population\",\"style\":{\"fontSize\":11}},\"style\":{\"radiusTopLeft\":4,\"radiusTopRight\":4},\"interaction\":{\"tooltip\":true}}",
      "commonErrors": [
        "Swapping xField and yField (bar is horizontal: xField is the value, yField is the category)",
        "Using callbacks for field values"
      ],
      "tips": "Bar is horizontal: xField = numeric values, yField = categories. Add labels for data values."
    },
    {
      "type": "area",
      "requiredFields": [
        "data",
        "xField",
        "yField"
      ],
      "example": "{\"type\":\"area\",\"data\":[{\"date\":\"2024-01\",\"value\":100,\"type\":\"Downloads\"},{\"date\":\"2024-02\",\"value\":150,\"type\":\"Downloads\"},{\"date\":\"2024-03\",\"value\":180,\"type\":\"Downloads\"},{\"date\":\"2024-04\",\"value\":220,\"type\":\"Downloads\"},{\"date\":\"2024-01\",\"value\":60,\"type\":\"Views\"},{\"date\":\"2024-02\",\"value\":90,\"type\":\"Views\"},{\"date\":\"2024-03\",\"value\":120,\"type\":\"Views\"},{\"date\":\"2024-04\",\"value\":160,\"type\":\"Views\"}],\"xField\":\"date\",\"yField\":\"value\",\"colorField\":\"type\",\"stack\":true,\"style\":{\"fillOpacity\":0.55},\"interaction\":{\"tooltip\":true}}",
      "commonErrors": [
        "Same as line chart errors",
        "Not stacking multiple series properly"
      ],
      "tips": "Use stack:true for stacked areas. Use style.fillOpacity (0.3-0.6) for semi-transparent fills."
    },
    {
      "type": "pie",
      "requiredFields": [
        "data",
        "angleField",
        "colorField"
      ],
      "example": "{\"type\":\"pie\",\"data\":[{\"category\":\"Direct\",\"value\":335},{\"category\":\"Email\",\"value\":210},{\"category\":\"Social\",\"value\":274},{\"category\":\"Search\",\"value\":235},{\"category\":\"Referral\",\"value\":180}],\"angleField\":\"value\",\"colorField\":\"category\",\"innerRadius\":0.55,\"label\":{\"text\":\"value\",\"style\":{\"fontSize\":11}},\"interaction\":{\"tooltip\":true}}",
      "commonErrors": [
        "Using xField/yField instead of angleField/colorField",
        "Not providing colorField for legend"
      ],
      "tips": "Use innerRadius (0.4-0.6) for donut style. Include 4-8 slices for readability."
    },
    {
      "type": "scatter",
      "requiredFields": [
        "data",
        "xField",
        "yField"
      ],
      "example": "{\"type\":\"scatter\",\"data\":[{\"height\":170,\"weight\":65,\"gender\":\"Male\"},{\"height\":165,\"weight\":55,\"gender\":\"Female\"},{\"height\":180,\"weight\":80,\"gender\":\"Male\"},{\"height\":160,\"weight\":50,\"gender\":\"Female\"},{\"height\":175,\"weight\":72,\"gender\":\"Male\"},{\"height\":168,\"weight\":58,\"gender\":\"Female\"}],\"xField\":\"height\",\"yField\":\"weight\",\"colorField\":\"gender\",\"sizeField\":5,\"style\":{\"fillOpacity\":0.7},\"interaction\":{\"tooltip\":true}}",
      "commonErrors": [
        "Missing colorField for category distinction",
        "Data points not in array"
      ],
      "tips": "Use colorField to categorize points. Use sizeField for bubble effect. Include 10+ data points for clarity."
    },
    {
      "type": "radar",
      "requiredFields": [
        "data",
        "xField",
        "yField"
      ],
      "example": "{\"type\":\"radar\",\"data\":[{\"dimension\":\"Speed\",\"score\":90,\"product\":\"Product A\"},{\"dimension\":\"Reliability\",\"score\":75,\"product\":\"Product A\"},{\"dimension\":\"Design\",\"score\":85,\"product\":\"Product A\"},{\"dimension\":\"Price\",\"score\":60,\"product\":\"Product A\"},{\"dimension\":\"Features\",\"score\":80,\"product\":\"Product A\"},{\"dimension\":\"Speed\",\"score\":70,\"product\":\"Product B\"},{\"dimension\":\"Reliability\",\"score\":90,\"product\":\"Product B\"},{\"dimension\":\"Design\",\"score\":65,\"product\":\"Product B\"},{\"dimension\":\"Price\",\"score\":85,\"product\":\"Product B\"},{\"dimension\":\"Features\",\"score\":75,\"product\":\"Product B\"}],\"xField\":\"dimension\",\"yField\":\"score\",\"colorField\":\"product\",\"area\":{\"style\":{\"fillOpacity\":0.25}},\"interaction\":{\"tooltip\":true}}",
      "commonErrors": [
        "Wrong field names for radar dimensions",
        "Not normalizing values to similar scale"
      ],
      "tips": "Include 5-8 dimensions. Use colorField for multi-product comparison. Add area.style.fillOpacity for filled radar."
    },
    {
      "type": "gauge",
      "requiredFields": [
        "data"
      ],
      "example": "{\"type\":\"gauge\",\"data\":{\"target\":75,\"total\":100,\"name\":\"Progress\"},\"style\":{\"textContent\":\"75%\"}}",
      "commonErrors": [
        "Missing percent or value field",
        "Using callbacks for custom rendering"
      ],
      "tips": "Use data.target and data.total for gauge value. Use style.textContent for center text."
    },
    {
      "type": "heatmap",
      "requiredFields": [
        "data",
        "xField",
        "yField",
        "colorField"
      ],
      "example": "{\"type\":\"heatmap\",\"data\":[{\"day\":\"Mon\",\"hour\":\"9am\",\"value\":10},{\"day\":\"Mon\",\"hour\":\"12pm\",\"value\":25},{\"day\":\"Mon\",\"hour\":\"3pm\",\"value\":18},{\"day\":\"Tue\",\"hour\":\"9am\",\"value\":15},{\"day\":\"Tue\",\"hour\":\"12pm\",\"value\":30},{\"day\":\"Tue\",\"hour\":\"3pm\",\"value\":22},{\"day\":\"Wed\",\"hour\":\"9am\",\"value\":8},{\"day\":\"Wed\",\"hour\":\"12pm\",\"value\":28},{\"day\":\"Wed\",\"hour\":\"3pm\",\"value\":16}],\"xField\":\"day\",\"yField\":\"hour\",\"colorField\":\"value\",\"label\":{\"text\":\"value\",\"style\":{\"fontSize\":10}},\"interaction\":{\"tooltip\":true}}",
      "commonErrors": [
        "Missing colorField for intensity",
        "Not providing proper grid data structure"
      ],
      "tips": "Provide complete grid data (every x-y combination). Use labels to show values in cells."
    },
    {
      "type": "funnel",
      "requiredFields": [
        "data"
      ],
      "example": "{\"type\":\"funnel\",\"data\":[{\"stage\":\"Visitors\",\"count\":10000},{\"stage\":\"Leads\",\"count\":5000},{\"stage\":\"Prospects\",\"count\":2500},{\"stage\":\"Negotiations\",\"count\":1200},{\"stage\":\"Closed Deals\",\"count\":600}],\"xField\":\"stage\",\"yField\":\"count\",\"label\":{\"text\":\"count\",\"style\":{\"fontSize\":11}},\"interaction\":{\"tooltip\":true}}",
      "commonErrors": [
        "Data not sorted by funnel order (largest to smallest)",
        "Missing value field for stage size"
      ],
      "tips": "Sort data from largest to smallest stage. Include 4-6 stages. Add labels for counts."
    },
    {
      "type": "histogram",
      "requiredFields": [
        "data",
        "binField"
      ],
      "example": "{\"type\":\"histogram\",\"data\":[{\"value\":15},{\"value\":22},{\"value\":28},{\"value\":35},{\"value\":42},{\"value\":48},{\"value\":55},{\"value\":62},{\"value\":38},{\"value\":45},{\"value\":30},{\"value\":25},{\"value\":50},{\"value\":58},{\"value\":33}],\"binField\":\"value\",\"style\":{\"radiusTopLeft\":2,\"radiusTopRight\":2},\"interaction\":{\"tooltip\":true}}",
      "commonErrors": [
        "Using xField instead of binField",
        "Not providing raw data for binning"
      ],
      "tips": "Provide 15+ raw data points for meaningful distribution. Use binField for the numeric field to bin."
    },
    {
      "type": "dualAxes",
      "requiredFields": [
        "data"
      ],
      "example": "{\"type\":\"dualAxes\",\"data\":[{\"month\":\"Jan\",\"revenue\":120,\"growthRate\":0.12},{\"month\":\"Feb\",\"revenue\":180,\"growthRate\":0.18},{\"month\":\"Mar\",\"revenue\":150,\"growthRate\":0.15},{\"month\":\"Apr\",\"revenue\":200,\"growthRate\":0.22}],\"xField\":\"month\",\"yField\":[\"revenue\",\"growthRate\"],\"interaction\":{\"tooltip\":true}}",
      "commonErrors": [
        "Not specifying two y-axis configurations",
        "Mixing incompatible chart types"
      ],
      "tips": "Use yField as an array of two field names. Provide a flat dataset with both metrics."
    }
  ]
}
